<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F3FB"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BƯỚC 2 / 3"
        android:textColor="#867AFB"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chạm vào chất riêng"
        android:textColor="#1E1B2E"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_white_card"
        android:scaleType="fitCenter" />

    <!-- Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        <Button android:id="@+id/btnFilterPink" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Korean Pink" />
        <Button android:id="@+id/btnFilterBW" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="B&amp;W" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sbBeauty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progress="65" />

    <Button
        android:id="@+id/btnProceedFrame"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="CHỌN KHUNG ➔"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_gradient_button" />

</LinearLayout>
