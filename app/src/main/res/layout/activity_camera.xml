<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1B2E">

    <!-- Flash Overlay -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:elevation="10dp" />

    <!-- Camera Preview Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:layout_above="@id/bottomBar"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible" />

        <!-- Countdown Number Overlay -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Nút chuyển đổi Camera Trước / Sau -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/circle_background"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Đổi Camera" />

    </androidx.cardview.widget.CardView>

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1E1B2E"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvShotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHỤP 1 / 4"
            android:textColor="#867AFB"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginEnd="24dp" />

        <!-- Circular Capture Shutter Button -->
        <Button
            android:id="@+id/btnCaptureShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_gradient_button" />

    </LinearLayout>

</RelativeLayout>
