<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F3FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SNAPVIBE 2026"
            android:textColor="#867AFB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp" />

        <!-- Logo Circle Gradient -->
        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu lại\nnhững kỉ niệm mới"
            android:textColor="#1E1B2E"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Photobooth online cho mọi khoảnh khắc đáng nhớ"
            android:textColor="#767389"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Card Chọn Số Tấm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BƯỚC 1 / 3"
                android:textColor="#867AFB"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn số ảnh"
                android:textColor="#1E1B2E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btnShots2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="2"
                    android:textColor="#1E1B2E"
                    android:backgroundTint="#F4F3FB" />

                <Button
                    android:id="@+id/btnShots4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_pill_active"
                    android:layout_marginHorizontal="8dp" />

                <Button
                    android:id="@+id/btnShots6"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="6"
                    android:textColor="#1E1B2E"
                    android:backgroundTint="#F4F3FB" />
            </LinearLayout>

        </LinearLayout>

        <!-- Main Action Buttons -->
        <Button
            android:id="@+id/btnStartCamera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✦ BẮT ĐẦU CHỤP ẢNH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/bg_gradient_button" />

        <Button
            android:id="@+id/btnUploadDevice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="📁 TẢI ẢNH TỪ THIẾT BỊ"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_dark_pill" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không cần đăng ký · Lưu ảnh riêng tư"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
